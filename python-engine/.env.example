# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=production
LOG_LEVEL=INFO

# MongoDB. Use a replica set (Atlas, or the `local` compose profile with ?replicaSet=rs0):
# change streams (PnL cache invalidation) need one.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/algo_trading?retryWrites=true&w=majority
# Only used by the Python engine when MONGO_URI has no database name
MONGO_DB_NAME=algo_trading

REDIS_HOST=redis
REDIS_PORT=6379

# >= 32 characters
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=1d

# Exactly 32 BYTES (AES-256). Shared by the Node API and the Python engine.
# generate one:  openssl rand -hex 16
AES_SECRET_KEY=

PORT=3000
# CORS origin. Leave empty when everything is served through the nginx gateway.
FRONTEND_URL=

# Python engine
USE_MOCK_BROKER=false
KOTAK_BASE_URL=https://mis.kotaksecurities.com


AI_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=
AI_TIMEOUT_SEC=30
AI_MAX_TOKENS=1500
# every HTTP call to the LLM counts (a review needs 1-4); counter lives in Redis ai:calls:{UTC date}
AI_DAILY_CALL_CAP=200
# client-side throttle for free-tier requests-per-minute limits
AI_MIN_SECONDS_BETWEEN_CALLS=2.5


